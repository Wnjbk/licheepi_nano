diff --git a/linux/drivers/usb/musb/musb_host.c b/linux/drivers/usb/musb/musb_host.c
index 6f4985e..c3ac52e 100644
--- a/linux/drivers/usb/musb/musb_host.c
+++ b/linux/drivers/usb/musb/musb_host.c
@@ -91,6 +91,25 @@ static void musb_aic_log_qh(const char *tag, struct musb_qh *qh,
 {
 }
 
+static bool musb_qh_is_rtl8723bu(struct musb_qh *qh)
+{
+	return qh && qh->dev &&
+		le16_to_cpu(qh->dev->descriptor.idVendor) == 0x0bda &&
+		le16_to_cpu(qh->dev->descriptor.idProduct) == 0xb720;
+}
+
+static void musb_rtl8723bu_log_qh(const char *tag, struct musb *musb,
+				  struct musb_qh *qh, int is_in)
+{
+	if (!musb_qh_is_rtl8723bu(qh) || !qh->hw_ep)
+		return;
+
+	dev_info_ratelimited(musb->controller,
+		"rtl8723bu %s usb-ep=%u dir=%s type=%u hw-ep=%u mux=%u\n",
+		tag, qh->epnum, is_in ? "in" : "out", qh->type,
+		qh->hw_ep->epnum, qh->mux);
+}
+
 /*
  * Clear TX fifo. Needed to avoid BABBLE errors.
  */
@@ -241,6 +260,7 @@ musb_start_urb(struct musb *musb, int is_in, struct musb_qh *qh)
 
 	trace_musb_urb_start(musb, urb);
 	musb_aic_log_qh("start_urb", qh, urb, is_in);
+	musb_rtl8723bu_log_qh("start", musb, qh, is_in);
 
 	/* Configure endpoint */
 	musb_ep_set_qh(hw_ep, is_in, qh);
@@ -2150,6 +2170,7 @@ success:
 	}
 	qh->hw_ep = hw_ep;
 	qh->hep->hcpriv = qh;
+	musb_rtl8723bu_log_qh("schedule", musb, qh, is_in);
 	if (idle)
 		musb_start_urb(musb, is_in, qh);
 	return 0;
