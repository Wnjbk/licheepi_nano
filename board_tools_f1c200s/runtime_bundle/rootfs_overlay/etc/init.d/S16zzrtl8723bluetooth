#!/bin/sh

# Bind the Bluetooth interfaces after the USB host script, then bring hci0 up
# before S17 claims the RTL8723BU Wi-Fi interface.
MODULE_DIR=/root/system_modules/rtl8723bluetooth
PATH=/usr/sbin:/usr/bin:/sbin:/bin

case "${1:-start}" in
    start)
        for mod in btrtl btbcm btintel btusb; do
            grep -q "^${mod} " /proc/modules 2>/dev/null && continue
            [ -r "$MODULE_DIR/${mod}.ko" ] || exit 0
            /sbin/insmod "$MODULE_DIR/${mod}.ko" || exit 0
        done
        i=0
        while [ ! -d /sys/class/bluetooth/hci0 ] && [ "$i" -lt 50 ]; do
            sleep 0.1
            i=$((i + 1))
        done
        if [ -d /sys/class/bluetooth/hci0 ]; then
            sleep 1
            hciconfig hci0 up >/tmp/rtl8723bluetooth.early.log 2>&1 || true
        fi
        ;;
esac

exit 0
