config VIDEO_SUNIV_F1C100S_TVD
	tristate "Allwinner F1C100S/F1C200S TVD capture driver"
	depends on VIDEO_DEV && VIDEO_V4L2
	depends on ARCH_SUNXI || COMPILE_TEST
	depends on OF
	select VIDEOBUF2_DMA_CONTIG
	select VIDEOBUF2_V4L2
	select DMA_SHARED_BUFFER
	help
	  V4L2 capture driver for the analog TV decoder found on
	  Allwinner F1C100S/F1C200S class SoCs.

	  The current driver exposes /dev/videoX and captures NV16 frames.

	  To compile this driver as a module, choose M here. The module will
	  be called suniv_f1c100s_tvd.

