#!/bin/sh

# Bind the Bluetooth interfaces after the USB host script, before S17 claims
# the RTL8723BU Wi-Fi interface. HCI UP must not block WLAN startup.
MODULE_DIR=/root/system_modules/rtl8723bluetooth
PATH=/usr/sbin:/usr/bin:/sbin:/bin

case "${1:-start}" in
    start)
        for mod in btrtl btbcm btintel btusb; do
            grep -q "^${mod} " /proc/modules 2>/dev/null && continue
            [ -r "$MODULE_DIR/${mod}.ko" ] || exit 0
            /sbin/insmod "$MODULE_DIR/${mod}.ko" || exit 0
        done
        # RTL8723B firmware starts after USB enumeration. Let it finish before
        # S17 initializes the companion Wi-Fi interface.
        sleep 3
        ;;
esac

exit 0
